 ## Créditos
 Gráficos dibujados por código (sin imágenes externas). Fuentes de los datos: ver `datos.js`.
+
+## Acceso desde otras redes
+- **Misma red (Wi-Fi/LAN):** `python app.py` ya escucha en `0.0.0.0:5000`; abrir `http://IP-DE-TU-PC:5000` (ver IP con `ip a`). Puede hacer falta abrir el puerto 5000 en el firewall.
+- **Otras redes, rápido (temporal):** con el servidor corriendo, `cloudflared tunnel --url http://localhost:5000` o `ngrok http 5000` entregan un enlace público.
+- **Publicarlo (Render, Railway, etc.):** Build `pip install -r requirements.txt`, Start `gunicorn app:app`. En el plan gratuito el disco es temporal: los puntajes del servidor se pierden al reiniciar (variable `DATA_DIR` para apuntar a un disco persistente).
+- `FLASK_DEBUG=1 python app.py` solo para desarrollo (activa el depurador y limita el servidor a localhost).
diff --git a/app.py b/app.py
index a777e14..3da04bb 100644
--- a/app.py
+++ b/app.py
@@ -1,11 +1,14 @@
 """Servidor Flask: entrega el juego (carpeta src/) y una API de puntajes."""
 import json
+import os
+import threading
 from pathlib import Path
 
 from flask import Flask, jsonify, request
 
 BASE = Path(__file__).parent
-ARCHIVO = BASE / "puntajes.json"
+ARCHIVO = Path(os.environ.get("DATA_DIR", BASE)) / "puntajes.json"
+CANDADO = threading.Lock()
 app = Flask(__name__, static_folder=str(BASE / "src"), static_url_path="")
 
 
@@ -34,11 +37,18 @@ def guardar_puntaje():
         return jsonify(error="Nombre inválido (1 a 20 caracteres)"), 400
     if not isinstance(puntos, int) or isinstance(puntos, bool) or not 0 <= puntos <= 1_000_000:
         return jsonify(error="Puntos inválidos"), 400
-    registros = leer_puntajes()
-    registros.append({"nombre": nombre.strip(), "puntos": puntos})
-    ARCHIVO.write_text(json.dumps(registros[-200:], ensure_ascii=False), encoding="utf-8")
+    with CANDADO:
+        registros = leer_puntajes()
+        registros.append({"nombre": nombre.strip(), "puntos": puntos})
+        temporal = ARCHIVO.with_suffix(".tmp")
+        temporal.write_text(json.dumps(registros[-200:], ensure_ascii=False), encoding="utf-8")
+        temporal.replace(ARCHIVO)
     return jsonify(ok=True), 201
 
 
 if __name__ == "__main__":
-    app.run(debug=True)
+    # Por defecto escucha en todas las interfaces (accesible desde otros equipos).
+    # FLASK_DEBUG=1 solo para desarrollo: activa el depurador, así que se limita a localhost.
+    depurar = os.environ.get("FLASK_DEBUG") == "1"
+    app.run(host="127.0.0.1" if depurar else os.environ.get("HOST", "0.0.0.0"),
+            port=int(os.environ.get("PORT", 5000)), debug=depurar)
